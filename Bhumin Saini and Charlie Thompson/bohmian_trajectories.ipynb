        "# Section 5 — Bohmian Velocity Field & Interpolators"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "LL7TN123fWy3"
      },
      "outputs": [],
      "source": [
        "def velocity_field(psi, dx):\n",
        "    \"\"\"\n",
        "    Compute the Bohmian guidance velocity field from a wave function snapshot.\n",
        "\n",
        "    Parameters\n",
        "    psi : (N_GRID, N_GRID) complex — wave function snapshot\n",
        "    dx  : float                    — spatial grid spacing\n",
        "\n",
        "    Returns\n",
        "    v1, v2 : (N_GRID, N_GRID) arrays — velocity of particle 1 and particle 2\n",
        "    \"\"\"\n",
        "    eps  = 1e-20                         # regularisation to avoid /0 at nodes\n",
        "    rho  = np.abs(psi)**2 + eps\n",
        "    dp1  = np.gradient(psi, dx, axis=0)  # ∂Ψ/∂x₁\n",
        "    dp2  = np.gradient(psi, dx, axis=1)  # ∂Ψ/∂x₂\n",
        "    v1   = (HBAR / MASS) * np.imag(dp1 * np.conj(psi)) / rho\n",
        "    v2   = (HBAR / MASS) * np.imag(dp2 * np.conj(psi)) / rho\n",
        "    return np.clip(v1, -50, 50), np.clip(v2, -50, 50)\n",
        "\n",
        "\n",
        "\n",
        "def build_interpolators(snaps, x, dx):\n",
        "    \"\"\"\n",
        "    Pre-compute velocity interpolators for every saved snapshot.\n",
        "\n",
        "    Parameters\n",
        "    snaps : list of (N_GRID, N_GRID) arrays — wave function snapshots\n",
        "    x     : (N_GRID,) array                 — spatial grid\n",
        "    dx    : float                           — spatial step\n",
        "\n",
        "    Returns\n",
        "    v1i, v2i : lists of RegularGridInterpolator objects one per snapshot\n",
        "    \"\"\"\n",
        "    v1i, v2i = [], []\n",
        "    kw = dict(method='linear', bounds_error=False, fill_value=0.0)\n",
        "    for psi in snaps:\n",
        "        v1, v2 = velocity_field(psi, dx)\n",
        "        v1i.append(RegularGridInterpolator((x, x), v1, **kw))\n",
        "        v2i.append(RegularGridInterpolator((x, x), v2, **kw))\n",
        "    return v1i, v2i"
      ]
    },
    {
      "cell_type": "markdown",
