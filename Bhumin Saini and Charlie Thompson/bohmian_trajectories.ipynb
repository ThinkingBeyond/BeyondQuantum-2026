        "def build_grid():\n",
        "    \"\"\"\n",
        "    Returns\n",
        "    x        : (N_GRID,) array  — spatial grid points\n",
        "    dx       : float            — spatial step size\n",
        "    dt       : float            — Crank-Nicolson time step\n",
        "    dt_snap  : float            — time between saved snapshots\n",
        "    \"\"\"\n",
        "    x       = np.linspace(X_MIN, X_MAX, N_GRID, endpoint=False)\n",
        "    dx      = x[1] - x[0]\n",
        "    dt      = (T_END - T_START) / N_STEPS\n",
        "    dt_snap = dt * SAVE_EVERY\n",
        "    return x, dx, dt, dt_snap\n",
        "\n",
        "\n",
        "def gaussian_packet(x, x0, p0, sigma):\n",
        "    \"\"\"\n",
        "    Construct a 1D unnormalised Gaussian wave packet.\n",
        "    φ(x) = exp(-(x-x0)²/2σ²) · exp(i·p0·x/ℏ)\n",
        "    Parameters\n",
        "    x     : (N,) array — spatial grid\n",
        "    x0    : float      — initial position centre\n",
        "    p0    : float      — initial mean momentum\n",
        "    sigma : float      — wavepacket width\n",
        "\n",
        "    Returns\n",
        "    (N,) complex array\n",
        "    \"\"\"\n",
        "    return (np.exp(-(x - x0)**2 / (2 * sigma**2))\n",
        "            * np.exp(1j * p0 / HBAR * x))\n",
        "\n",
        "\n",
        "def normalize(psi, dx):\n",
        "    \"\"\"\n",
        "    Normalise a 2D wave function so that ∫|Ψ|² dx₁ dx₂ = 1.\n",
        "\n",
        "    Parameters\n",
        "    psi : (N, N) complex array — unnormalised two-body wave function\n",
        "    dx  : float                — spatial grid spacing\n",
        "\n",
        "    Returns\n",
        "    (N, N) complex array, normalised\n",
        "    \"\"\"\n",
        "    return psi / np.sqrt(np.sum(np.abs(psi)**2) * dx**2)\n"
      ]
    },
