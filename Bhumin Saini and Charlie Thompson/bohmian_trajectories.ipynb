      "source": [
        "#Metric 1: KL divergence of the 1-body marginal densities at t=0.\n",
        "def kl_divergence(Psi_ref, Psi_other, dx, label=\"\"):\n",
        "    rho_r   = np.sum(np.abs(Psi_ref)**2,   axis=1) * dx\n",
        "    rho_o = np.sum(np.abs(Psi_other)**2, axis=1) * dx\n",
        "    rho_r   /= rho_r.sum();  rho_o /= rho_o.sum()\n",
        "    eps = 1e-30\n",
        "    kl    = float(np.sum(rho_r * np.log((rho_r + eps) / (rho_o + eps))))\n",
        "    note  = 'fair start ✓' if kl < 1e-6 else '⚠ non-zero'\n",
        "    print(f'  KL(S1 | {label}) = {kl:.3e}   {note}')\n",
        "    return kl\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "WazPa-oehdDx"
      },
      "outputs": [],
      "source": [
        "#Metric 2: Classify final positions into 4 quadrants and compute independence ratio.\n",
        "def outcomes(X_traj, N_traj):\n",
        "  x1f = X_traj[-1, :, 0]\n",
        "  x2f = X_traj[-1, :, 1]\n",
        "  TT  = int(np.sum((x1f > 0) & (x2f > 0)))\n",
        "  RR  = int(np.sum((x1f < 0) & (x2f < 0)))\n",
        "  TR  = int(np.sum((x1f > 0) & (x2f < 0)))\n",
        "  RT  = int(np.sum((x1f < 0) & (x2f > 0)))\n",
        "  T1   = (TT + TR) / N_traj\n",
        "  T2   = (TT + RT) / N_traj\n",
        "  T1T2 = T1 * T2\n",
        "\n",
        "  independence = (TT / N_traj) / T1T2 if T1T2 > 1e-18 else np.nan\n",
        "\n",
        "  return dict(TT=TT, RR=RR, TR=TR, RT=RT,\n",
        "              T1=T1, T2=T2, T1T2=T1T2,\n",
        "              TT_frac=TT / N_traj,\n",
        "              independence=independence\n",
        "  )"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "amtYSyxsGwRs"
      },
      "outputs": [],
      "source": [
        "#Metric 3: norm ratio r(n) = ‖Ψⁿ‖/‖Ψ⁰‖. Should be identically 1.\n",
        "def compute_norm_ratio(norms):\n",
        "  norms = np.array(norms)\n",
        "  beta  = norms / norms[0]\n",
        "  return beta"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "i_RZovIPvmj2"
      },
      "outputs": [],
      "source": [
        "#Metric 4: Pearson velocity correlation ρᵥ(t) across the ensemble.\n",
        "def compute_velocity_correlation(X_traj, v1_interp, v2_interp):\n",
        "  n_snaps = len(v1_interp)\n",
        "  rho_v   = np.zeros(n_snaps)\n",
        "\n",
        "  for s in range(n_snaps):\n",
        "      X   = X_traj[s]\n",
        "      v1s = v1_interp[s](X)\n",
        "      v2s = v2_interp[s](X)\n",
        "      if np.std(v1s) > 1e-10 and np.std(v2s) > 1e-10:\n",
        "          rho_v[s], _ = pearsonr(v1s, v2s)\n",
        "\n",
        "  return rho_v"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "aW4o1wElNg6-"
      },
      "outputs": [],
      "source": [
        "# Metric 5: Reduced chi-squared test of Born-rule adherence at t_mid.\n",
        "def born_chi2(x_at_snap, psi_at_snap, x, dx, min_expected=5):\n",
        "    n_traj = x_at_snap.shape[0]\n",
        "    n_bins = int(np.clip(int(np.floor(np.sqrt(n_traj / min_expected))), 3, 15))\n",
        "    edges  = np.linspace(X_MIN, X_MAX, n_bins + 1)\n",
        "    obs, _, _ = np.histogram2d(x_at_snap[:, 0], x_at_snap[:, 1], bins=[edges, edges])\n",
        "    x1_coords   = np.repeat(x, N_GRID)\n",
        "    x2_coords   = np.tile(x, N_GRID)\n",
        "    rho_weights = (np.abs(psi_at_snap)**2).flatten() * dx**2\n",
        "    exp_counts, _, _ = np.histogram2d(x1_coords, x2_coords, bins=[edges, edges], weights=rho_weights)\n",
        "    total_prob = exp_counts.sum()\n",
        "    if total_prob < 1e-15 or obs.sum() < 1:\n",
        "        return float('nan')\n",
        "    exp_counts = exp_counts * (obs.sum() / total_prob)\n",
        "    mask    = exp_counts >= min_expected\n",
        "    n_valid = int(mask.sum())\n",
        "    if n_valid < 2:\n",
        "        return float('nan')\n",
        "    chi2_stat = float(np.sum((obs[mask] - exp_counts[mask])**2 / exp_counts[mask]))\n",
        "    return chi2_stat / (n_valid - 1)\n"
      ]
    },
