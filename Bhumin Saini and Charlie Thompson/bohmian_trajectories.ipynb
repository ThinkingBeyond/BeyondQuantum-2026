      "outputs": [],
      "source": [
        "#Von Neumann entanglement entropy via Schmidt decomposition.\n",
        "def compute_entanglement_entropy(psi_snap, dx, stride=5):\n",
        "    idxs = list(range(0, len(psi_snap), stride))\n",
        "    if idxs[-1] != len(psi_snap) - 1:\n",
        "        idxs.append(len(psi_snap) - 1)\n",
        "\n",
        "    entropies = []\n",
        "\n",
        "    for i in idxs:\n",
        "        psi = psi_snap[i]\n",
        "\n",
        "        # Normalize\n",
        "        psi = psi / np.sqrt(np.sum(np.abs(psi)**2) * dx**2 + 1e-30)\n",
        "\n",
        "        # Singular values to probabilities\n",
        "        s = np.linalg.svd(psi, compute_uv=False)\n",
        "        p = s**2 / np.sum(s**2)\n",
        "\n",
        "        # Entropy\n",
        "        entropies.append(-np.sum(p * np.log(p + 1e-30)))\n",
        "\n",
        "    return np.array(idxs), np.array(entropies)"
      ]
    },
