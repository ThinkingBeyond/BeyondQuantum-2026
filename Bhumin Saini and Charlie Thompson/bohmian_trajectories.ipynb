      "source": [
        "#Validation A: RK4 vs RK45 trajectory consistency.\n",
        "def validate_rk45(results):\n",
        "    print('Validation A — RK4 vs RK45 trajectory consistency')\n",
        "    print(f'{\"Stage\":<34} {\"maxRMS\":>8} {\"max|Δρᵥ|\":>11} {\"ΔI\":>8} {\"Time\":>6}  OK?')\n",
        "    print('-' * 72)\n",
        "    for res in results:\n",
        "        t0    = time.time()\n",
        "        t_arr = np.array(res['t_snap'])\n",
        "        xr45  = integrate_rk45(res['x_init'], res['v1i'], res['v2i'], t_arr)\n",
        "        xr4   = res['x_traj'][:, :N_RK45, :]\n",
        "        rms   = float(np.sqrt(np.mean((xr4 - xr45)**2, axis=(1, 2))).max())\n",
        "        drho  = float(np.max(np.abs(\n",
        "            compute_velocity_correlation(xr4, res['v1i'], res['v2i']) -\n",
        "            compute_velocity_correlation(xr45, res['v1i'], res['v2i']))))\n",
        "        i4    = outcomes(xr4,  N_RK45)['independence']\n",
        "        i45   = outcomes(xr45, N_RK45)['independence']\n",
        "        di    = 0.0 if (np.isnan(i4) and np.isnan(i45)) else abs(i4 - i45)\n",
        "        ok    = 'OK' if rms < 0.5 and di < 0.15 else 'NOT OK'\n",
        "        print(f'{res[\"label\"]:<34} {rms:>8.4f} {drho:>11.4f} {di:>8.4f} {time.time()-t0:>5.1f}s  {ok}')\n",
        "\n",
        "\n",
        "def validate_norms(results):\n",
        "    print('Validation B — Norm conservation  (should stay around 1.0000)')\n",
        "    print(f'{\"Stage\":<34} {\"min\":>10} {\"max\":>10} {\"max drift\":>10}  OK?')\n",
        "    print('-' * 72)\n",
        "    for res in results:\n",
        "        r  = res['norm_ratio']\n",
        "        d  = float(np.max(np.abs(r - 1.0)))\n",
        "        ok = 'OK' if d < 1e-8 else 'NOT OK'\n",
        "        print(f'{res[\"label\"]:<34} {r.min():>10.8f} {r.max():>10.8f} {d:>10.2e}  {ok}')\n",
        "\n",
        "\n",
        "def validate_born_rule(results):\n",
        "    print('Validation C — Born-rule chi-square  (good if chi2_red < 3)')\n",
        "    print(f'{\"Stage\":<34} {\"chi2_red\":>10}  OK?')\n",
        "    print('-' * 72)\n",
        "    for res in results:\n",
        "        ok = 'OK' if not np.isnan(res['chi2']) and res['chi2'] < 3.0 else 'NOT OK'\n",
        "        print(f'{res[\"label\"]:<34} {res[\"chi2\"]:>10.3f}  {ok}')\n",
        "\n",
        "\n",
        "def print_summary(results, kl_dict):\n",
        "    def fmt(v, f='.4f'):\n",
        "        return 'N/A' if (isinstance(v, float) and np.isnan(v)) else f'{v:{f}}'\n",
        "\n",
        "    col_width = 14\n",
        "    header_parts = [f'{\"Metric\":<32}'] + [f'{r[\"label\"][:col_width]:>{col_width}}' for r in results]\n",
        "    sep = '=' * (32 + col_width * len(results) + len(results))\n",
        "\n",
        "    print(f'\\n{sep}')\n",
        "    print('FINAL SUMMARY TABLE')\n",
        "    print(sep)\n",
        "    print(''.join(header_parts))\n",
        "    print('-' * len(sep))\n",
        "\n",
        "    row_defs = [\n",
        "        ('max |ρᵥ(t)|',          '.4f', lambda r: np.max(np.abs(r['rho_v']))),\n",
        "        ('T1',                    '.4f', lambda r: r['cnts']['T1']),\n",
        "        ('T2',                    '.4f', lambda r: r['cnts']['T2']),\n",
        "        ('T1*T2',                 '.4f', lambda r: r['cnts']['T1T2']),\n",
        "        ('TT/(T1*T2)',            '.4f', lambda r: r['cnts']['independence']),\n",
        "        ('Final entropy [nats]',  '.4f', lambda r: r['entropy'][1][-1]),\n",
        "        ('Born χ²_red',           '.3f', lambda r: r['chi2']),\n",
        "    ]\n",
        "    for lbl, spec, fn in row_defs:\n",
        "        row = f'{lbl:<32}' + ''.join(f'{fmt(fn(r), spec):>{col_width}}' for r in results)\n",
        "        print(row)\n",
        "\n",
        "    print('\\nKL divergences (t=0 marginals vs Stage 1):')\n",
        "    for k, v in kl_dict.items():\n",
        "        print(f'  {k:<24} {v:.3e}   {\"fair start \" if v < 1e-6 else \"non-zero\"}')\n",
        "\n",
        "    print('\\nOutcome counts:')\n",
        "    for res in results:\n",
        "        c = res['cnts']\n",
        "        print(f'  {res[\"label\"]:<36}  TT={c[\"TT\"]:4d}  RR={c[\"RR\"]:4d}  TR={c[\"TR\"]:4d}  RT={c[\"RT\"]:4d}')\n",
        "    print(sep)"
      ]
    },
