        "def run_stage(label, psi0, A, B, x, dx, dt, dt_snap, n_traj, n_sub,\n",
        "              use_phase_ramp=False, seed=2024,\n",
        "              ext_snaps=None, ext_v1i=None, ext_v2i=None, ext_x_init=None):\n",
        "    t0 = time.time()\n",
        "\n",
        "    # Step 1: evolve\n",
        "    if ext_snaps is not None:\n",
        "        snaps, t_snap, norms = ext_snaps\n",
        "    elif use_phase_ramp:\n",
        "        snaps, t_snap, norms = evolve_phase_ramp(psi0, A, B, x, dx, dt)\n",
        "    else:\n",
        "        snaps, t_snap, norms = evolve_standard(psi0, A, B, dx, dt)\n",
        "\n",
        "    # Step 2: velocity interpolators\n",
        "    if ext_v1i is not None:\n",
        "        v1i, v2i = ext_v1i, ext_v2i\n",
        "    else:\n",
        "        v1i, v2i = build_interpolators(snaps, x, dx)\n",
        "\n",
        "    # Step 3: initial position sampling\n",
        "    x_init = ext_x_init if ext_x_init is not None else sample_positions(psi0, x, dx, n_traj, seed)\n",
        "\n",
        "    # Step 4: RK4 integration\n",
        "    x_traj = integrate_rk4(x_init, v1i, v2i, dt_snap, n_sub)\n",
        "\n",
        "    # Step 5: metrics\n",
        "    rho_v  = compute_velocity_correlation(x_traj, v1i, v2i)\n",
        "    cnts   = outcomes(x_traj, n_traj)\n",
        "    colors = trajectory_colors(x_traj)\n",
        "    S      = compute_entanglement_entropy(snaps, dx)\n",
        "    mid    = len(snaps) // 2\n",
        "    chi2   = born_chi2(x_traj[mid], snaps[mid], x, dx)\n",
        "\n",
        "    elapsed = time.time() - t0\n",
        "    print(f'[{label}] TT={cnts[\"TT\"]} RR={cnts[\"RR\"]} TR={cnts[\"TR\"]} RT={cnts[\"RT\"]} '\n",
        "          f'| I={cnts[\"independence\"]:.4f} | S_final={S[1][-1]:.4f} | {elapsed:.1f}s')\n",
        "\n",
        "    return {\n",
        "        'label':      label,\n",
        "        'snaps':      snaps,\n",
        "        't_snap':     t_snap,\n",
        "        't_arr':      np.array(t_snap, dtype=np.float64),\n",
        "        'norms':      norms,\n",
        "        'norm_ratio': compute_norm_ratio(norms),\n",
        "        'x_init':     x_init,\n",
        "        'x_traj':     x_traj,\n",
        "        'n_traj':     n_traj,\n",
        "        'v1i':        v1i,\n",
        "        'v2i':        v2i,\n",
        "        'rho_v':      rho_v,\n",
        "        'cnts':       cnts,\n",
        "        'colors':     colors,\n",
        "        'entropy':    S,\n",
        "        'chi2':       chi2,\n",
        "    }"
      ]
    },
