        "    (psi0_s2b, 'Stage 2B initial (Product → Phase-Ramped during run)'),\n",
        "]:\n",
        "    plot_density(psi, 0.0, title)\n",
        "\n",
        "res_s1 = run_stage(\n",
        "    label    = 'Stage 1 (Product)',\n",
        "    psi0     = psi0_s1,\n",
