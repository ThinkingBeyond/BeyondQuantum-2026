      "source": [
        "#Build list of snapshot indices to use as animation frames.\n",
        "def _frame_list(n_snaps):\n",
        "    frames = list(range(0, n_snaps, VIZ_SKIP))\n",
        "    if frames[-1] != n_snaps - 1:\n",
        "        frames.append(n_snaps - 1)\n",
        "    return frames\n",
        "\n",
        "#Rotating 3D space-time braid animation for one stage.\n",
        "def animate_3d_braid(res):\n",
        "\n",
        "    x_traj   = res['x_traj']\n",
        "    t_snap   = res['t_snap']\n",
        "    colors   = res['colors']\n",
        "    n_traj   = res['n_traj']\n",
        "    t_arr    = np.array(t_snap)\n",
        "    frames   = _frame_list(len(t_snap))\n",
        "    n_frames = len(frames)\n",
        "\n",
        "    plt.style.use('dark_background')\n",
        "    fig = plt.figure(figsize=(10, 8))\n",
        "    fig.patch.set_facecolor('#020514')\n",
        "    fig.suptitle(f'{res[\"label\"]} — Bohmian Strands in Space-Time',\n",
        "                 color='white', fontsize=13)\n",
        "\n",
        "    ax = fig.add_subplot(111, projection='3d')\n",
        "    ax.set_facecolor('#020514')\n",
        "    ax.set_xlim(X_MIN, X_MAX); ax.set_ylim(X_MIN, X_MAX); ax.set_zlim(T_START, T_END)\n",
        "    ax.set_xlabel('$x_1$', color='#aaaacc')\n",
        "    ax.set_ylabel('$x_2$', color='#aaaacc')\n",
        "    ax.set_zlabel('$t$',   color='#aaaacc')\n",
        "    ax.tick_params(colors='#888899', labelsize=7)\n",
        "    ax.xaxis.set_pane_color((0.02, 0.02, 0.08, 1.0))\n",
        "    ax.yaxis.set_pane_color((0.02, 0.02, 0.08, 1.0))\n",
        "    ax.zaxis.set_pane_color((0.02, 0.02, 0.08, 1.0))\n",
        "\n",
        "    # Barrier walls (gold planes)\n",
        "    _sp = np.linspace(X_MIN, X_MAX, 30)\n",
        "    _tp = np.linspace(T_START, T_END, 30)\n",
        "    _sg, _tg = np.meshgrid(_sp, _tp)\n",
        "    for surf_args in [\n",
        "        (np.full_like(_sg, X_BARRIER), _sg, _tg),\n",
        "        (_sg, np.full_like(_sg, X_BARRIER), _tg),\n",
        "    ]:\n",
        "        ax.plot_surface(*surf_args, color='#ffaa00', alpha=0.12,\n",
        "                        linewidth=0, antialiased=False, zorder=0)\n",
        "    ax.plot([X_BARRIER, X_BARRIER], [X_MIN, X_MAX], [T_START, T_START],\n",
        "            color='#ffaa00', lw=1.5, alpha=0.8, zorder=2)\n",
        "    ax.plot([X_MIN, X_MAX], [X_BARRIER, X_BARRIER], [T_START, T_START],\n",
        "            color='#ffaa00', lw=1.5, alpha=0.8, zorder=2)\n",
        "\n",
        "    # Trajectory strands\n",
        "    lines = [ax.plot([], [], [], color=colors[i], lw=0.7, alpha=0.75)[0]\n",
        "             for i in range(n_traj)]\n",
        "    dots = ax.scatter(x_traj[0, :, 0], x_traj[0, :, 1],\n",
        "                      np.full(n_traj, t_snap[0]), c=colors, s=20, edgecolors='none', zorder=10)\n",
        "\n",
        "    for k, col in OUTCOME_CMAP.items():\n",
        "        ax.plot([], [], [], color=col, lw=2, label=f\"{'T' if k[0] else 'R'}{'T' if k[1] else 'R'}\")\n",
        "    ax.legend(loc='upper left', facecolor='#111133', edgecolor='#334',\n",
        "              labelcolor='white', fontsize=8)\n",
        "\n",
        "    ttext = ax.text2D(0.02, 0.96, f'$t = {t_snap[0]:.2f}$',\n",
        "                      transform=ax.transAxes, color='white', fontsize=10)\n",
        "\n",
        "    def update(frame):\n",
        "        s    = frames[frame]\n",
        "        azim = -60 + (frame / max(n_frames - 1, 1)) * 240\n",
        "        ax.view_init(elev=25, azim=azim)\n",
        "        for i, ln in enumerate(lines):\n",
        "            ln.set_data_3d(x_traj[:s+1, i, 0], x_traj[:s+1, i, 1], t_arr[:s+1])\n",
        "        dots._offsets3d = (x_traj[s, :, 0], x_traj[s, :, 1], np.full(n_traj, t_snap[s]))\n",
        "        ttext.set_text(f'$t = {t_snap[s]:.2f}$')\n",
        "        return lines + [dots, ttext]\n",
        "\n",
        "    ani = animation.FuncAnimation(fig, update, frames=n_frames,\n",
        "                                  interval=100, blit=False, repeat=True)\n",
        "    plt.tight_layout()\n",
        "    _show_ani(ani, title=f'{res[\"label\"]} — 3D Braid')\n",
        "    return ani\n",
        "\n",
        "\n",
        "def animate_multistage(results):\n",
        "    #Side-by-side 2D animation of all stages in lockstep.\n",
        "    n_snaps = len(results[0]['t_snap'])\n",
        "    frames  = _frame_list(n_snaps)\n",
        "\n",
        "    plt.style.use('dark_background')\n",
        "    n_cols = 2\n",
        "    n_rows = (len(results) + 1) // 2\n",
        "    fig, axes = plt.subplots(n_rows, n_cols, figsize=(13, 5.5 * n_rows))\n",
        "    fig.patch.set_facecolor('#06060f')\n",
        "    fig.suptitle('All Stages — Bohmian Configuration Space (simultaneous)',\n",
        "                 color='white', fontsize=14)\n",
        "\n",
        "    bgs, lines_list, dots_list, ttexts = [], [], [], []\n",
        "\n",
        "    for ax, res in zip(axes.flat, results):\n",
        "        ax.set_facecolor('#0a0a1e')\n",
        "        ax.set_xlim(X_MIN, X_MAX); ax.set_ylim(X_MIN, X_MAX)\n",
        "        ax.set_title(res['label'], color='white', fontsize=10)\n",
        "        ax.axvline(0, color='#ffaa00', lw=0.8, ls='--', alpha=0.6, zorder=1)\n",
        "        ax.axhline(0, color='#ffaa00', lw=0.8, ls='--', alpha=0.6, zorder=1)\n",
        "        ax.tick_params(colors='#aaaacc', labelsize=7)\n",
        "        for sp in ax.spines.values(): sp.set_edgecolor('#222244')\n",
        "\n",
        "        rho0 = np.abs(res['snaps'][0])**2\n",
        "        bg = ax.imshow(rho0.T, origin='lower', cmap='hot',\n",
        "                       extent=[X_MIN, X_MAX, X_MIN, X_MAX],\n",
        "                       aspect='auto', alpha=0.45, zorder=0)\n",
        "        bgs.append(bg)\n",
        "\n",
        "        lns = [ax.plot([], [], color=res['colors'][i], lw=0.5, alpha=0.60, zorder=2)[0]\n",
        "               for i in range(res['n_traj'])]\n",
        "        lines_list.append(lns)\n",
        "\n",
        "        dots = ax.scatter(res['x_traj'][0, :, 0], res['x_traj'][0, :, 1],\n",
        "                          c=res['colors'], s=11, edgecolors='none', zorder=5)\n",
        "        dots_list.append(dots)\n",
        "\n",
        "        tt = ax.text(0.03, 0.97, f't = {res[\"t_snap\"][0]:.2f}',\n",
        "                     transform=ax.transAxes, color='white', fontsize=9, va='top', fontweight='bold')\n",
        "        ttexts.append(tt)\n",
        "        ax.legend(handles=legend_handles(res['x_traj']), loc='lower right',\n",
        "                  facecolor='#111133', edgecolor='#334', labelcolor='white', fontsize=6)\n",
        "\n",
        "    for ax in axes.flat[len(results):]:\n",
        "        ax.set_visible(False)\n",
        "\n",
        "    def update(frame):\n",
        "        s       = frames[frame]\n",
        "        artists = []\n",
        "        for j, res in enumerate(results):\n",
        "            snap_s = min(s, len(res['snaps']) - 1)\n",
        "            rho    = np.abs(res['snaps'][snap_s])**2\n",
        "            bgs[j].set_data(rho.T)\n",
        "            bgs[j].set_clim(0, rho.max() + 1e-20)\n",
        "            for i, ln in enumerate(lines_list[j]):\n",
        "                ln.set_data(res['x_traj'][:snap_s+1, i, 0],\n",
        "                            res['x_traj'][:snap_s+1, i, 1])\n",
        "            dots_list[j].set_offsets(res['x_traj'][snap_s])\n",
        "            ttexts[j].set_text(f't = {res[\"t_snap\"][snap_s]:.2f}')\n",
        "            artists += [bgs[j]] + lines_list[j] + [dots_list[j], ttexts[j]]\n",
        "        return artists\n",
        "\n",
        "    ani = animation.FuncAnimation(fig, update, frames=len(frames),\n",
        "                                  interval=90, blit=True, repeat=True)\n",
        "    plt.tight_layout()\n",
        "    _show_ani(ani, title='All Stages — Multistage')\n",
        "    return ani"
      ]
    },
