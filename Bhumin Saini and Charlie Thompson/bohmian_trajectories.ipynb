      },
      "source": [
        "# Section 6 — Trajectory Sampling & Integration  (RK4 + RK45)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "XbJAHbT3xQP9"
      },
      "outputs": [],
      "source": [
        "def sample_positions(psi0, x, dx, n_traj, seed=2024):\n",
        "    \"\"\"\n",
        "    Sample initial Bohmian positions from the Born distribution |Ψ₀|².\n",
        "\n",
        "    Returns\n",
        "    -------\n",
        "    (n_traj, 2) array — initial positions [[x1, x2], ...]\n",
        "    \"\"\"\n",
        "    rng      = np.random.default_rng(seed)\n",
        "    prob     = np.abs(psi0)**2 * dx**2\n",
        "    prob    /= prob.sum()\n",
        "    flat_idx = rng.choice(N_GRID**2, size=n_traj, p=prob.flatten())\n",
        "    rows, cols = flat_idx // N_GRID, flat_idx % N_GRID\n",
        "    jitter   = rng.uniform(-dx / 2, dx / 2, size=(n_traj, 2))\n",
        "    return np.column_stack([x[rows] + jitter[:, 0], x[cols] + jitter[:, 1]])\n",
        "\n",
        "def query_velocity(X, v1_interp, v2_interp):\n",
        "  v1 = v1_interp(X)\n",
        "  v2 = v2_interp(X)\n",
        "  return np.column_stack([v1, v2])\n",
        "\n",
        "def query_velocity_2b(X, v1a, v2a, v1b, v2b, alpha):\n",
        "    return ((1 - alpha) * query_velocity(X, v1a, v2a)\n",
        "            + alpha     * query_velocity(X, v1b, v2b))\n",
        "\n",
        "def integrate_rk4(x_init, v1i, v2i, dt_snap, n_sub):\n",
        "    \"\"\"\n",
        "    Integrate Bohmian trajectories using 4th-order Runge-Kutta.\n",
        "\n",
        "    Parameters\n",
        "    x_init  : (n_traj, 2) array — initial positions\n",
        "    v1i, v2i: lists of interpolators\n",
        "    dt_snap : float             — time between snapshots\n",
        "    n_sub   : int               — RK4 sub-steps per snapshot interval\n",
        "\n",
        "    Returns\n",
        "    x_traj : (n_snaps, n_traj, 2) array — full trajectory history\n",
        "    \"\"\"\n",
        "    n_traj  = x_init.shape[0]\n",
        "    n_snaps = len(v1i)\n",
        "    dt_sub  = dt_snap / n_sub\n",
        "    x_traj     = np.zeros((n_snaps, n_traj, 2))\n",
        "    x_traj[0]  = x_init.copy()\n",
        "    x_cur      = x_init.copy()\n",
        "\n",
        "    for s in range(n_snaps - 1):\n",
        "        v1a, v2a = v1i[s],     v2i[s]\n",
        "        v1b, v2b = v1i[s + 1], v2i[s + 1]\n",
        "        for sub in range(n_sub):\n",
        "            a0   = sub / n_sub\n",
        "            amid = (sub + 0.5) / n_sub\n",
        "            a1   = (sub + 1.0) / n_sub\n",
        "            k1 = query_velocity_2b(x_cur,                 v1a, v2a, v1b, v2b, a0)\n",
        "            k2 = query_velocity_2b(x_cur + dt_sub/2 * k1, v1a, v2a, v1b, v2b, amid)\n",
        "            k3 = query_velocity_2b(x_cur + dt_sub/2 * k2, v1a, v2a, v1b, v2b, amid)\n",
        "            k4 = query_velocity_2b(x_cur + dt_sub   * k3, v1a, v2a, v1b, v2b, a1)\n",
        "            x_cur = x_cur + (dt_sub / 6.0) * (k1 + 2*k2 + 2*k3 + k4)\n",
        "        x_traj[s + 1] = x_cur\n",
        "\n",
        "    return x_traj\n",
        "\n",
        "def integrate_rk45(x_init, v1i, v2i, t_snap_arr):\n",
        "    \"\"\"\n",
        "    Adaptive RK45 (Dormand-Prince) integration for N_RK45 trajectories.\n",
        "\n",
        "    Parameters\n",
        "    ----------\n",
        "    x_init     : (n_traj, 2) initial positions\n",
        "    v1i, v2i   : interpolator lists\n",
        "    t_snap_arr : (n_snaps,) array of snapshot times\n",
        "\n",
        "    Returns\n",
        "    -------\n",
        "    x_traj : (n_snaps, N_RK45, 2) array\n",
        "    \"\"\"\n",
        "    n_traj  = min(N_RK45, x_init.shape[0])\n",
        "    n_snaps = len(t_snap_arr)\n",
        "    x_traj  = np.zeros((n_snaps, n_traj, 2))\n",
        "    x_traj[0] = x_init[:n_traj].copy()\n",
        "\n",
        "    def rhs(t, y):\n",
        "        X   = y.reshape(n_traj, 2)\n",
        "        idx = int(np.clip(\n",
        "            np.searchsorted(t_snap_arr, t, side='right') - 1, 0, n_snaps - 2))\n",
        "        dti = t_snap_arr[idx + 1] - t_snap_arr[idx]\n",
        "        a   = float(np.clip((t - t_snap_arr[idx]) / dti, 0, 1)) if dti > 1e-15 else 0.0\n",
        "        return query_velocity_2b(X, v1i[idx], v2i[idx],\n",
        "                         v1i[idx+1], v2i[idx+1], a).flatten()\n",
        "\n",
        "    sol = solve_ivp(rhs, (t_snap_arr[0], t_snap_arr[-1]),\n",
        "                    x_init[:n_traj].flatten(),\n",
        "                    method='RK45', t_eval=t_snap_arr, rtol=1e-4, atol=1e-6)\n",
        "    if sol.success:\n",
        "        for i in range(n_snaps):\n",
        "            x_traj[i] = sol.y[:, i].reshape(n_traj, 2)\n",
        "    return x_traj\n"
      ]
    },
