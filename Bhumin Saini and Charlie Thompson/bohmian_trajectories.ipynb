      "source": [
        "#Section 3 — Potential & Crank–Nicolson Matrices"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "vVhnPKQlvV_l"
      },
      "outputs": [],
      "source": [
        "def build_potential(x):\n",
        "    \"\"\"\n",
        "    Construct the two-body Gaussian barrier potential on the configuration grid.\n",
        "    V(x₁,x₂) = V₁(x₁) + V₁(x₂),   V₁(x) = V₀ exp(-x²/2σ_b²)\n",
        "\n",
        "    Parameters\n",
        "    x : (N_GRID,) array — spatial grid\n",
        "\n",
        "    Returns\n",
        "    V : (N_GRID, N_GRID) array — two-body potential,\n",
        "    \"\"\"\n",
        "    V1 = V0 * np.exp(-x**2 / (2 * SIGMA_BARRIER**2))\n",
        "    return V1[:, None] + V1[None, :]   # additive separable potential\n",
        "\n",
        "def build_cn_matrices(x, V, dt):\n",
        "    \"\"\"\n",
        "    Build the sparse Crank-Nicolson\n",
        "\n",
        "    Parameters\n",
        "    x  : (N_GRID,) array     — spatial grid\n",
        "    V  : (N_GRID, N_GRID)    — two-body potential\n",
        "    dt : float               — time step Δt\n",
        "\n",
        "    Returns\n",
        "    A, B : scipy sparse csc_matrix (N_GRID², N_GRID²)\n",
        "    \"\"\"\n",
        "    dx    = x[1] - x[0]\n",
        "    alpha = HBAR**2 / (2.0 * MASS * dx**2)   # kinetic coefficient\n",
        "    r     = 1j * dt / (2.0 * HBAR)            # Crank-Nicolson prefactor\n",
        "\n",
        "    # 1D tridiagonal kinetic operator: -α[1,-2,1] stencil\n",
        "    T_1d = diags(\n",
        "        [np.full(N_GRID - 1, -alpha),\n",
        "         np.full(N_GRID,      2 * alpha),\n",
        "         np.full(N_GRID - 1, -alpha)],\n",
        "        offsets=[-1, 0, 1]\n",
        "    )\n",
        "\n",
        "    # 2D kinetic operator via Kronecker product\n",
        "    I  = eye(N_GRID)\n",
        "    H  = kron(T_1d, I) + kron(I, T_1d) + diags(V.flatten())\n",
        "\n",
        "    # Crank-Nicolson matrices\n",
        "    I2 = eye(N_GRID**2)\n",
        "    A  = csc_matrix(I2 + r * H)\n",
        "    B  = csc_matrix(I2 - r * H)\n",
        "    return A, B\n",
        "\n"
      ]
    },
