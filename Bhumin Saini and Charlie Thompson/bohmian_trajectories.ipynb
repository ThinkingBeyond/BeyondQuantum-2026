        "id": "SDl_XLrn-jJl"
      },
      "source": [
        "# Section 4 — Wavefunction Evolution"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "-lgBX-Mr-izy"
      },
      "outputs": [],
      "source": [
        "def evolve_standard(psi0, A, B, dx, dt):\n",
        "    \"\"\"\n",
        "    Propagate Ψ using plain Crank-Nicolson (Stages 1 and 2A).\n",
        "\n",
        "    Parameters\n",
        "    psi0 : (N_GRID, N_GRID) complex  — initial wave function\n",
        "    A, B : sparse csc_matrix         — Crank-Nicolson\n",
        "    dx   : float                     — spatial step\n",
        "    dt   : float                     — time step\n",
        "\n",
        "    Returns\n",
        "    snaps  : list of (N_GRID, N_GRID) arrays — wave function snapshots\n",
        "    t_snap : list of floats                  — times of each snapshot\n",
        "    norms  : list of floats                  — ∫|Ψ|² dx₁ dx₂ at each snapshot\n",
        "    \"\"\"\n",
        "    lu      = splu(A)\n",
        "    psi_vec = psi0.flatten().astype(complex)\n",
        "    snaps   = [psi0.copy()]\n",
        "    t_snap  = [T_START]\n",
        "    norms   = [float(np.sum(np.abs(psi0)**2) * dx**2)]\n",
        "\n",
        "    for step in range(1, N_STEPS + 1):\n",
        "        psi_vec = lu.solve(B.dot(psi_vec))\n",
        "        if step % SAVE_EVERY == 0:\n",
        "            psi_2d = psi_vec.reshape((N_GRID, N_GRID))\n",
        "            snaps.append(psi_2d.copy())\n",
        "            t_snap.append(T_START + step * dt)\n",
        "            norms.append(float(np.sum(np.abs(psi_2d)**2) * dx**2))\n",
        "\n",
        "    return snaps, t_snap, norms\n",
        "\n",
        "def evolve_phase_ramp(psi0, A, B, x, dx, dt,\n",
        "                      alpha_final=ALPHA_PHASE, t_ramp=T_RAMP_S2B):\n",
        "    \"\"\"\n",
        "    Stage 2B evolution: Crank-Nicolson + incremental phase kernel.\n",
        "\n",
        "    Parameters\n",
        "    psi0        :\n",
        "    A, B        : CN matrices\n",
        "    x           : spatial grid\n",
        "    dx, dt      : spatial and time step sizes\n",
        "    alpha_final : max coupling strength\n",
        "    t_ramp      : ramp duration\n",
        "\n",
        "    Returns\n",
        "    snaps, t_snap, norms\n",
        "    \"\"\"\n",
        "    lu         = splu(A)\n",
        "    psi_vec    = psi0.flatten().astype(complex)\n",
        "    kernel     = (x[:, None] - x[None, :])**2   # (x₁-x₂)² matrix, shape (N,N)\n",
        "    snaps      = [psi0.copy()]\n",
        "    t_snap     = [T_START]\n",
        "    norms      = [float(np.sum(np.abs(psi0)**2) * dx**2)]\n",
        "    alpha_prev = 0.0\n",
        "\n",
        "    for step in range(1, N_STEPS + 1):\n",
        "        t_cur     = T_START + step * dt\n",
        "        alpha_cur = alpha_final * min(t_cur / max(t_ramp, 1e-15), 1.0)\n",
        "        d_alpha   = alpha_cur - alpha_prev\n",
        "        alpha_prev = alpha_cur\n",
        "\n",
        "        # Apply incremental phase kernel\n",
        "        if abs(d_alpha) > 1e-15:\n",
        "            psi_vec *= np.exp(1j * d_alpha * kernel).flatten()\n",
        "\n",
        "        psi_vec = lu.solve(B.dot(psi_vec))\n",
        "\n",
        "        if step % SAVE_EVERY == 0:\n",
        "            psi_2d = psi_vec.reshape((N_GRID, N_GRID))\n",
        "            snaps.append(psi_2d.copy())\n",
        "            t_snap.append(t_cur)\n",
        "            norms.append(float(np.sum(np.abs(psi_2d)**2) * dx**2))\n",
        "\n",
        "    return snaps, t_snap, norms"
      ]
    },
