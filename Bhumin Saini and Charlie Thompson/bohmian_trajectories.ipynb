        "def build_product_state(x, dx):\n",
        "    \"\"\"\n",
        "    Stage 1: separable product state.\n",
        "\n",
        "    Ψ⁽(x₁,x₂) = N · φA(x₁) ⊗ φB(x₂)\n",
        "\n",
        "    Returns\n",
        "\n",
        "    (N_GRID, N_GRID) complex array, normalised\n",
        "    \"\"\"\n",
        "    phi_a = gaussian_packet(x, X_A_S1, P_A_S1, SIGMA_S1)\n",
        "    phi_b = gaussian_packet(x, X_B_S1, P_B_S1, SIGMA_S1)\n",
        "    return normalize(np.outer(phi_a, phi_b), dx)\n",
        "\n",
        "def build_symmetric_entangled(x, dx):\n",
        "    \"\"\"\n",
        "    Stage 2A: symmetrised superposition (bosonic)\n",
        "    Ψ(x₁,x₂) = N · [φA(x₁)φB(x₂) + φB(x₁)φA(x₂)]\n",
        "\n",
        "    Returns\n",
        "    (N_GRID, N_GRID) complex array, normalised\n",
        "    \"\"\"\n",
        "    phi_a = gaussian_packet(x, X_A_S2A, P_A_S2A, SIGMA_S2A)\n",
        "    phi_b = gaussian_packet(x, X_B_S2A, P_B_S2A, SIGMA_S2A)\n",
        "    return normalize(np.outer(phi_a, phi_b) + np.outer(phi_b, phi_a), dx)\n",
        "\n",
        "\n",
        "def build_phase_induced_initial(x, dx):\n",
        "    \"\"\"\n",
        "    Stage 2B: uses the same product stat.\n",
        "\n",
        "    Entanglement is induced dynamically during time evolution via the\n",
        "    phase kernel Ψ(t) → Ψ(t)·exp(iα(t)(x₁-x₂)²).\n",
        "    Returns\n",
        "    -------\n",
        "    (N_GRID, N_GRID) complex array, normalised\n",
        "    \"\"\"\n",
        "    return build_product_state(x, dx)\n",
        "\n"
      ]
    },
